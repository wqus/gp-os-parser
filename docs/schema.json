{
  "$defs": {
    "Discrepancy": {
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "title": "Values",
          "type": "array"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "field",
        "values",
        "explanation"
      ],
      "title": "Discrepancy",
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        }
      },
      "required": [
        "field",
        "text",
        "location"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Listing": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "intermark",
            "malina",
            "invest7",
            "s5d",
            "nfgroup"
          ],
          "title": "Source",
          "type": "string"
        },
        "listing_id": {
          "title": "Listing Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "last_successful_check_at": {
          "format": "date-time",
          "title": "Last Successful Check At",
          "type": "string"
        },
        "status": {
          "default": "active",
          "enum": [
            "active",
            "removed"
          ],
          "title": "Status",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "price_rub": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Rub"
        },
        "area_m2": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Area M2"
        },
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "map_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Map Url"
        },
        "map_url_generated": {
          "default": false,
          "title": "Map Url Generated",
          "type": "boolean"
        },
        "metro": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metro"
        },
        "vat": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vat"
        },
        "commission": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commission"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "ownership_form": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ownership Form"
        },
        "photos": {
          "items": {
            "type": "string"
          },
          "title": "Photos",
          "type": "array"
        },
        "tenants": {
          "items": {
            "$ref": "#/$defs/Tenant"
          },
          "title": "Tenants",
          "type": "array"
        },
        "rent_current_rub": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rent Current Rub"
        },
        "rent_future_rub": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rent Future Rub"
        },
        "payback_years": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payback Years"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "discrepancies": {
          "items": {
            "$ref": "#/$defs/Discrepancy"
          },
          "title": "Discrepancies",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "requested_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Category"
        },
        "replacement_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replacement Note"
        },
        "html_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Html File"
        },
        "html_sha256": {
          "title": "Html Sha256",
          "type": "string"
        }
      },
      "required": [
        "source",
        "listing_id",
        "url",
        "collected_at",
        "last_successful_check_at",
        "title",
        "description",
        "html_sha256"
      ],
      "title": "Listing",
      "type": "object"
    },
    "RentStep": {
      "properties": {
        "amount_rub": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount Rub"
        },
        "from_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Date"
        },
        "from_month": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Month"
        },
        "to_month": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Month"
        },
        "raw": {
          "title": "Raw",
          "type": "string"
        }
      },
      "required": [
        "raw"
      ],
      "title": "RentStep",
      "type": "object"
    },
    "Tenant": {
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "status": {
          "default": "unknown",
          "enum": [
            "current",
            "future",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "lease_start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease Start"
        },
        "lease_end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease End"
        },
        "lease_term_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease Term Raw"
        },
        "indexation_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Indexation Raw"
        },
        "rent_current_rub": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rent Current Rub"
        },
        "rent_future_rub": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rent Future Rub"
        },
        "rate_start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Start"
        },
        "rate_start_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Start Raw"
        },
        "rent_steps": {
          "items": {
            "$ref": "#/$defs/RentStep"
          },
          "title": "Rent Steps",
          "type": "array"
        },
        "turnover_formula_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turnover Formula Raw"
        },
        "source_excerpt": {
          "title": "Source Excerpt",
          "type": "string"
        }
      },
      "required": [
        "source_excerpt"
      ],
      "title": "Tenant",
      "type": "object"
    }
  },
  "additionalProperties": {
    "$ref": "#/$defs/Listing"
  },
  "type": "object",
  "title": "GP OS unified listing export"
}